## TowerDialogueData — 慈悲尖塔对话数据
## 仅精英层(第4/8/12层)有进场/退场对话，小怪层无对话
class_name TowerDialogueData
extends Resource

## 精英层进场对话（梅塔特隆介绍精英怪）
func get_floor_entry(floor_num: int) -> Dictionary:
	match floor_num:
		4: return {
			"speaker": "神官 · 梅塔特隆",
			"lines": [
				{ "text": "第四层。那里住着个被怨恨养大的亡灵。" },
				{ "text": "他以为自己还是王——其实只是塔养的狗。给它一根骨头，它就替塔守门。" },
				{ "text": "别被他身上的铁甲吓到。那身甲胄早就锈进肉里了。卸都卸不下来。" },
			]
		}
		8: return {
			"speaker": "神官 · 梅塔特隆",
			"lines": [
				{ "text": "第八层。有个少年在那儿做梦。" },
				{ "text": "他以为仙人模式能救他——但塔里没有自然之力。他的螺旋丸在这里转不了几圈。" },
				{ "text": "说起来，他跟我讲过一句话……算了。你已经走上来了，不必听死人说的废话。" },
			]
		}
		12: return {
			"speaker": "神官 · 梅塔特隆",
			"lines": [
				{ "text": "第十二层。最后一个守门人。" },
				{ "text": "那个人等着你很久了——不是因为他想赢，而是因为他想死在你手里。" },
				{ "text": "他比谁都聪明。聪明到知道这塔里没有出路，只有死路。所以他想让死路短一点。" },
				{ "text": "……别心软。他不会的。" },
			]
		}
		_:
			return {}

## 精英层退场对话（精英怪临终遗言）
func get_floor_exit(floor_num: int) -> Dictionary:
	match floor_num:
		4: return {
			"speaker": "",
			"lines": [
				{ "text": "（破败王者的铁甲碎裂，露出下面空洞的躯壳）" },
				{ "text": "我的……王座……不是……你们的……" },
				{ "speaker": "旁白", "text": "铁甲坍塌的回声在塔壁间回荡了很久。仇恨在他身上留下了比铁更硬的壳。现在，壳碎了，人也不见了。" },
			]
		}
		8: return {
			"speaker": "",
			"lines": [
				{ "text": "（仙人鸣人的螺旋丸在掌心慢慢消散）" },
				{ "text": "下一次……螺旋丸……一定……" },
				{ "speaker": "旁白", "text": "金色的查克拉像萤火虫一样散尽。少年闭上了眼——仿佛只是在他的梦里，睡了一小会儿。" },
			]
		}
		12: return {
			"speaker": "",
			"lines": [
				{ "text": "（司马懿缓缓坐下，整理衣冠）" },
				{ "text": "天命……不过如此。" },
				{ "text": "你替我看一眼……塔顶……" },
				{ "speaker": "旁白", "text": "他笑了一下。那笑容里没有怨恨，只有一种看透了所有棋局之后的、近乎温柔的无趣。" },
			]
		}
		_:
			return {}

## 通关对话
func get_victory_dialogue() -> Dictionary:
	return {
		"speaker": "神官 · 梅塔特隆",
		"lines": [
			{ "text": "……你出来了。" },
			{ "text": "一百零六个人走进去。你是第一个走出来的。" },
			{ "text": "（合上天书）" },
			{ "text": "……不，我什么都没写。这本天书，从来只记录死者。" },
			{ "text": "活人不需要我记。" },
			{ "text": "（梅塔特隆第一次抬眼看你）" },
			{ "text": "走吧。别再回来。" },
		]
	}
